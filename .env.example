NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

GUMROAD_ACCESS_TOKEN=REPLACE_ME
GUMROAD_ACCOUNT_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Separate random secret (32+ characters) for anonymous trial cookies and transcript receipts.
APP_SIGNING_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
# Full public origin; use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: route YouTube caption retrieval through a separate deployment/host.
# Set CAPTION_SERVICE_URL on the main Vercel app to the other deployment's origin.
# Set the SAME 32+ character CAPTION_SERVICE_SECRET on both deployments.
# Leave CAPTION_SERVICE_URL unset on the caption-service deployment so it fetches YouTube directly.
CAPTION_SERVICE_URL=
CAPTION_SERVICE_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
